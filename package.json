{
  "name": "wafer-widget",
  "version": "1.0.0",
  "description": "wafer-widget",
  "main": "lib/wafer-widget.min.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "engines": {
    "node": "~14||~16"
  },
  "scripts": {
    "watch": "rollup -c -w",
    "build": "rollup -c",
    "serve": "live-server --watch=./index.html,./lib --port=9999",
